{
  "name": "doan-nosql-recruitment",
  "version": "1.0.0",
  "private": true,
  "description": "Recruitment Management System using MongoDB, Mingo, Node.js and React",
  "scripts": {
    "install:all": "npm --prefix backend install && npm --prefix frontend install",
    "seed": "npm --prefix backend run seed",
    "backend": "npm --prefix backend start",
    "backend:dev": "npm --prefix backend run dev",
    "frontend": "npm --prefix frontend run dev",
    "build": "npm --prefix frontend run build",
    "backup": "npm --prefix backend run backup",
    "restore": "npm --prefix backend run restore",
    "test": "node backend/scripts/verify_project.js"
  }
}

